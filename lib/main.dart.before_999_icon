class DrawingPainter extends CustomPainter {
  const DrawingPainter({
    required this.drawings,
    required this.activePoints,
    required this.activeTool,
  });

  final List<ChartDrawing> drawings;
  final List<Offset> activePoints;
  final int activeTool;

  @override
  void paint(Canvas canvas, Size size) {
    for (final drawing in drawings) {
      _paintLine(canvas, size, drawing.tool, drawing.points);
    }
    if (activePoints.isNotEmpty) {
      _paintLine(canvas, size, activeTool, activePoints);
    }
  }

  void _paintLine(Canvas canvas, Size size, int tool, List<Offset> points) {
    if (points.length < 2) return;
    final color = tool == 2
        ? const Color(0xFFFFFFFF)
        : tool == 3
            ? const Color(0xFFB6F342)
            : const Color(0xFFE6FF27);
    final paint = Paint()
      ..color = color
      ..strokeWidth = tool == 2 ? 2.0 : 2.7
      ..strokeCap = StrokeCap.round
      ..strokeJoin = StrokeJoin.round
      ..style = PaintingStyle.stroke;
    final path = Path();
    for (int i = 0; i < points.length; i++) {
      final point =
          Offset(points[i].dx * size.width, points[i].dy * size.height);
      if (i == 0) {
        path.moveTo(point.dx, point.dy);
      } else {
        path.lineTo(point.dx, point.dy);
      }
    }
    canvas.drawPath(path, paint);
    if (tool == 4) {
      final start =
          Offset(points.first.dx * size.width, points.first.dy * size.height);
      final end =
          Offset(points.last.dx * size.width, points.last.dy * size.height);
      canvas.drawCircle(start, 3.5, Paint()..color = color);
      canvas.drawCircle(end, 3.5, Paint()..color = color);
    }
  }

  @override
  bool shouldRepaint(covariant DrawingPainter oldDelegate) => true;
}

class SparkPainter extends CustomPainter {
  const SparkPainter({required this.seed, required this.rising});

  final int seed;
  final bool rising;

  @override
  void paint(Canvas canvas, Size size) {
    final rng = math.Random(seed);
    final paint = Paint()
      ..color = rising ? const Color(0xFF4ED98A) : const Color(0xFFFF6574)
      ..strokeWidth = 1.4
      ..style = PaintingStyle.stroke;
    final path = Path();
    double y = size.height * .62;
    for (int i = 0; i < 14; i++) {
      final x = i * size.width / 13;
      y = (y + (rng.nextDouble() - .48) * 10 + (rising ? -.35 : .35))
          .clamp(5, size.height - 5)
          .toDouble();
      if (i == 0) {
        path.moveTo(x, y);
      } else {
        path.lineTo(x, y);
      }
    }
    canvas.drawPath(path, paint);
  }

  @override
  bool shouldRepaint(covariant SparkPainter oldDelegate) =>
      oldDelegate.seed != seed || oldDelegate.rising != rising;
}

class MarketChartPainter extends CustomPainter {
  const MarketChartPainter({
    required this.asset,
    required this.marketCandles,
    required this.livePrice,
    required this.timeframe,
    required this.tick,
    required this.chartStyle,
    required this.ema9,
    required this.ema21,
    required this.bollinger,
    required this.zigZag,
    required this.remainingSeconds,
    required this.zoom,
    required this.pan,
  });

  final AssetQuote asset;
  final List<MarketCandle> marketCandles;
  final double? livePrice;
  final String timeframe;
  final int tick;
  final String chartStyle;
  final bool ema9;
  final bool ema21;
  final bool bollinger;
  final bool zigZag;
  final int remainingSeconds;
  final double zoom;
  final double pan;

  @override
  void paint(Canvas canvas, Size size) {
    final chartRect = Rect.fromLTWH(0, 0, size.width, size.height);
    final background = Paint()
      ..shader = const LinearGradient(
        begin: Alignment.topLeft,
        end: Alignment.bottomRight,
        colors: [Color(0xFF182542), Color(0xFF10172A)],
      ).createShader(chartRect);
    canvas.drawRect(chartRect, background);
    _drawCityBackdrop(canvas, size);

    final grid = Paint()
      ..color = const Color(0xFF2A3652)
      ..strokeWidth = .8;
    for (int i = 0; i <= 9; i++) {
      final x = i * size.width / 9;
      canvas.drawLine(Offset(x, 0), Offset(x, size.height), grid);
    }
    for (int i = 0; i <= 7; i++) {
      final y = i * size.height / 7;
      canvas.drawLine(Offset(0, y), Offset(size.width, y), grid);
    }

    final chartData = _makeChartData();
    final candles = chartData.candles;
    final left = 20.0;
    final right = math.max(left + 40, size.width - 62);
    final top = 50.0;
    final bottom = math.max(top + 80, size.height - 36);
    final step = (right - left) / candles.length;

    double xFor(int index) => left + (index + .5) * step;
    double yFor(double value) => bottom - value * (bottom - top);

    final closes = candles.map((e) => e.close).toList();

    if (bollinger) {
      final upper = Path();
      final lower = Path();
      for (int i = 0; i < closes.length; i++) {
        final center = _average(closes, i, 8);
        final wave = .092 + math.sin(i * .31) * .012;
        final a = Offset(
          xFor(i),
          yFor((center + wave).clamp(.05, .95).toDouble()),
        );
        final b = Offset(
          xFor(i),
          yFor((center - wave).clamp(.05, .95).toDouble()),
        );
        if (i == 0) {
          upper.moveTo(a.dx, a.dy);
          lower.moveTo(b.dx, b.dy);
        } else {
          upper.lineTo(a.dx, a.dy);
          lower.lineTo(b.dx, b.dy);
        }
      }
      final band = Paint()
        ..color = const Color(0x995CD7FF)
        ..strokeWidth = 1.2
        ..style = PaintingStyle.stroke;
      canvas.drawPath(upper, band);
      canvas.drawPath(lower, band);
    }

    if (chartStyle == 'Candles') {
      for (int i = 0; i < candles.length; i++) {
        final candle = candles[i];
        final x = xFor(i);
        final openY = yFor(candle.open);
        final closeY = yFor(candle.close);
        final highY = yFor(candle.high);
        final lowY = yFor(candle.low);
        final rising = candle.close >= candle.open;
        final color =
            rising ? const Color(0xFF57E56D) : const Color(0xFFFF5B59);
        final paint = Paint()
          ..color = color
          ..strokeWidth = 1.3;
        canvas.drawLine(Offset(x, highY), Offset(x, lowY), paint);
        canvas.drawRect(
          Rect.fromLTRB(
            x - math.max(3.8, step * .36),
            math.min(openY, closeY),
            x + math.max(3.8, step * .36),
            math.max(openY, closeY) + 1.8,
          ),
          paint,
        );
      }
    } else {
      final linePath = Path();
      for (int i = 0; i < closes.length; i++) {
        final point = Offset(xFor(i), yFor(closes[i]));
        if (i == 0) {
          linePath.moveTo(point.dx, point.dy);
        } else {
          linePath.lineTo(point.dx, point.dy);
        }
      }
      canvas.drawPath(
        linePath,
        Paint()
          ..color = const Color(0xFF86B5FF)
          ..strokeWidth = 2.2
          ..style = PaintingStyle.stroke,
      );
    }

    if (ema9) {
      _drawMovingAverage(
          canvas, closes, 5, xFor, yFor, const Color(0xFFFFD45A), 1.8);
    }
    if (ema21) {
      _drawMovingAverage(
          canvas, closes, 11, xFor, yFor, const Color(0xFF7C90FF), 1.8);
    }
    if (zigZag) {
      final path = Path();
      for (int i = 0; i < closes.length; i += 5) {
        final point = Offset(xFor(i), yFor(closes[i]));
        if (i == 0) {
          path.moveTo(point.dx, point.dy);
        } else {
          path.lineTo(point.dx, point.dy);
        }
      }
      canvas.drawPath(
        path,
        Paint()
          ..color = const Color(0xFFC977FF)
          ..strokeWidth = 1.2
          ..style = PaintingStyle.stroke,
      );
    }

    final expirationX = size.width * .79;
    final expirationPaint = Paint()
      ..color = const Color(0x99FFFFFF)
      ..strokeWidth = 1.2;
    canvas.drawLine(
      Offset(expirationX, 0),
      Offset(expirationX, bottom),
      expirationPaint,
    );
    _text(
      canvas,
      'Expiration  ${_clock(remainingSeconds)}',
      Offset(expirationX + 7, 54),
      9,
      Colors.white70,
    );

    final currentY = yFor(closes.last);
    final priceLine = Paint()
      ..color = const Color(0xFF6DC8FF)
      ..strokeWidth = 1;
    for (double x = 0; x < size.width; x += 9) {
      canvas.drawLine(Offset(x, currentY), Offset(x + 4, currentY), priceLine);
    }

    _drawPriceScale(
      canvas,
      size,
      top,
      bottom,
      chartData.minimumPrice,
      chartData.maximumPrice,
    );
    _drawTimeScale(canvas, size, left, right, chartData.times);
  }

  _ChartData _makeChartData() {
    if (marketCandles.length >= 2) {
      final historyCount = marketCandles.length;
      final maximumVisible = math.min(58, historyCount);
      final minimumVisible = math.min(16, maximumVisible);
      final visibleCount =
          (34 / zoom).round().clamp(minimumVisible, maximumVisible).toInt();
      final maxShift = historyCount - visibleCount;
      final shift = (pan * maxShift).round().clamp(0, maxShift).toInt();
      final end = historyCount - shift;
      final start = end - visibleCount;
      final visible = marketCandles.sublist(start, end);

      var minimum = visible.first.low;
      var maximum = visible.first.high;
      for (final candle in visible.skip(1)) {
        minimum = math.min(minimum, candle.low).toDouble();
        maximum = math.max(maximum, candle.high).toDouble();
      }
      final rawRange =
          math.max(maximum - minimum, maximum.abs() * .0001).toDouble();
      final paddedMinimum = minimum - rawRange * .12;
      final paddedMaximum = maximum + rawRange * .12;
      final paddedRange = paddedMaximum - paddedMinimum;
      double normalize(double price) {
        return ((price - paddedMinimum) / paddedRange)
            .clamp(.02, .98)
            .toDouble();
      }

      return _ChartData(
        candles: visible
            .map((candle) => _Candle(
                  normalize(candle.open),
                  normalize(candle.high),
                  normalize(candle.low),
                  normalize(candle.close),
                ))
            .toList(growable: false),
        minimumPrice: paddedMinimum,
        maximumPrice: paddedMaximum,
        times: visible.map((candle) => candle.time).toList(growable: false),
      );
    }

    final seed = asset.symbol.codeUnits.fold<int>(17, (a, b) => a * 31 + b);
    final rng = math.Random(seed);
    final result = <_Candle>[];
    double close = .48;
    const historyCount = 120;
    for (int i = 0; i < historyCount; i++) {
      final open = close;
      var movement = (rng.nextDouble() - .48) * .14;
      movement += math.sin(i * .43 + seed % 7) * .018;
      if (i == historyCount - 1) {
        movement += math.sin(tick * .62) * .035;
      }
      close = (open + movement).clamp(.12, .88).toDouble();
      final high = (math.max(open, close) + rng.nextDouble() * .055)
          .clamp(.08, .94)
          .toDouble();
      final low = (math.min(open, close) - rng.nextDouble() * .055)
          .clamp(.06, .92)
          .toDouble();
      result.add(_Candle(open, high, low, close));
    }

    final visibleCount = (34 / zoom).round().clamp(16, 58).toInt();
    final maxShift = historyCount - visibleCount;
    final shift = (pan * maxShift).round().clamp(0, maxShift).toInt();
    final end = historyCount - shift;
    final start = end - visibleCount;
    final visible = result.sublist(start, end);
    final range = asset.price.abs() * .0018;
    return _ChartData(
      candles: visible,
      minimumPrice: asset.price - range * .5,
      maximumPrice: asset.price + range * .5,
      times: const <DateTime>[],
    );
  }

  double _average(List<double> values, int index, int period) {
    final start = math.max(0, index - period + 1);
    double total = 0;
    for (int i = start; i <= index; i++) {
      total += values[i];
    }
    return total / (index - start + 1);
  }

  void _drawCityBackdrop(Canvas canvas, Size size) {
    final rng = math.Random(999);
    final horizon = size.height * .73;
    final haze = Paint()
      ..shader = const LinearGradient(
        begin: Alignment.topCenter,
        end: Alignment.bottomCenter,
        colors: [Color(0x001D4D8C), Color(0x242D6AA7)],
      ).createShader(Rect.fromLTWH(0, size.height * .18, size.width, horizon));
    canvas.drawRect(
      Rect.fromLTWH(0, size.height * .18, size.width, horizon),
      haze,
    );

    double x = -8;
    while (x < size.width) {
      final width = 24 + rng.nextDouble() * 48;
      final buildingHeight = 45 + rng.nextDouble() * size.height * .28;
      final rect = Rect.fromLTWH(
        x,
        horizon - buildingHeight,
        width,
        buildingHeight,
      );
      canvas.drawRect(rect, Paint()..color = const Color(0x1A84A9D8));
      final roof = Path()
        ..moveTo(x, rect.top)
        ..lineTo(x + width * .5, rect.top - rng.nextDouble() * 14)
        ..lineTo(x + width, rect.top)
        ..close();
      canvas.drawPath(roof, Paint()..color = const Color(0x1684A9D8));
      for (double windowX = x + 7; windowX < x + width - 4; windowX += 11) {
        for (double windowY = rect.top + 10;
            windowY < horizon - 5;
            windowY += 13) {
          if (rng.nextDouble() > .54) {
            canvas.drawRect(
              Rect.fromLTWH(windowX, windowY, 3, 2),
              Paint()..color = const Color(0x24B8D6FF),
            );
          }
        }
      }
      x += width + 5;
    }
    canvas.drawRect(
      Rect.fromLTWH(0, horizon, size.width, size.height - horizon),
      Paint()..color = const Color(0x17050A14),
    );
  }

  String _clock(int seconds) {
    final minutes = seconds ~/ 60;
    final remainder = seconds % 60;
    return '${minutes.toString().padLeft(2, '0')}:${remainder.toString().padLeft(2, '0')}';
  }

  void _drawMovingAverage(
    Canvas canvas,
    List<double> closes,
    int period,
    double Function(int) xFor,
    double Function(double) yFor,
    Color color,
    double width,
  ) {
    final path = Path();
    for (int i = 0; i < closes.length; i++) {
      final value = _average(closes, i, period);
      final point = Offset(xFor(i), yFor(value));
      if (i == 0) {
        path.moveTo(point.dx, point.dy);
      } else {
        path.lineTo(point.dx, point.dy);
      }
    }
    canvas.drawPath(
      path,
      Paint()
        ..color = color
        ..strokeWidth = width
        ..style = PaintingStyle.stroke,
    );
  }

  void _drawPriceScale(
    Canvas canvas,
    Size size,
    double top,
    double bottom,
    double minimumPrice,
    double maximumPrice,
  ) {
    for (int i = 0; i <= 5; i++) {
      final ratio = 1 - i / 5;
      final y = top + i * (bottom - top) / 5;
      final value = minimumPrice + ratio * (maximumPrice - minimumPrice);
      final decimals = value.abs() >= 10000
          ? 0
          : value.abs() >= 10
              ? 3
              : 5;
      _text(canvas, value.toStringAsFixed(decimals),
          Offset(size.width - 56, y - 6), 8, Colors.white54);
    }
  }

  void _drawTimeScale(
    Canvas canvas,
    Size size,
    double left,
    double right,
    List<DateTime> times,
  ) {
    if (times.isEmpty) {
      const labels = ['11:56', '12:08', '12:20', '12:32', '12:44', '12:56'];
      for (int i = 0; i < labels.length; i++) {
        final x = left + i * (right - left) / (labels.length - 1);
        _text(canvas, labels[i], Offset(x - 13, size.height - 18), 8,
            Colors.white38);
      }
      return;
    }

    const labelCount = 6;
    for (int i = 0; i < labelCount; i++) {
      final index = (i * (times.length - 1) / (labelCount - 1)).round();
      final local = times[index].toLocal();
      final label =
          '${local.hour.toString().padLeft(2, '0')}:${local.minute.toString().padLeft(2, '0')}';
      final x = left + i * (right - left) / (labelCount - 1);
      _text(canvas, label, Offset(x - 13, size.height - 18), 8, Colors.white38);
    }
  }

  void _text(
      Canvas canvas, String text, Offset offset, double size, Color color) {
    final painter = TextPainter(
      text:
          TextSpan(text: text, style: TextStyle(fontSize: size, color: color)),
      textDirection: TextDirection.ltr,
    )..layout();
    painter.paint(canvas, offset);
  }

  @override
  bool shouldRepaint(covariant MarketChartPainter oldDelegate) {
    return oldDelegate.asset.symbol != asset.symbol ||
        oldDelegate.marketCandles != marketCandles ||
        oldDelegate.livePrice != livePrice ||
        oldDelegate.timeframe != timeframe ||
        oldDelegate.tick != tick ||
        oldDelegate.chartStyle != chartStyle ||
        oldDelegate.ema9 != ema9 ||
        oldDelegate.ema21 != ema21 ||
        oldDelegate.bollinger != bollinger ||
        oldDelegate.zigZag != zigZag ||
        oldDelegate.remainingSeconds != remainingSeconds ||
        oldDelegate.zoom != zoom ||
        oldDelegate.pan != pan;
  }
}

class _ChartData {
  const _ChartData({
    required this.candles,
    required this.minimumPrice,
    required this.maximumPrice,
    required this.times,
  });

  final List<_Candle> candles;
  final double minimumPrice;
  final double maximumPrice;
  final List<DateTime> times;
}

class _Candle {
  const _Candle(this.open, this.high, this.low, this.close);

  final double open;
  final double high;
  final double low;
  final double close;
}

class IndicatorPainter extends CustomPainter {
  const IndicatorPainter({
    required this.variant,
    required this.tick,
    required this.marketCandles,
    required this.zoom,
    required this.pan,
  });

  final int variant;
  final int tick;
  final List<MarketCandle> marketCandles;
  final double zoom;
  final double pan;

  @override
  void paint(Canvas canvas, Size size) {
    final grid = Paint()
      ..color = const Color(0xFF2A3550)
      ..strokeWidth = .7;
    for (int i = 1; i < 4; i++) {
      final y = i * size.height / 4;
      canvas.drawLine(Offset(0, y), Offset(size.width, y), grid);
    }

    final candles = _visibleCandles();
    if (candles.length < 2) {
      _paintSynthetic(canvas, size);
      return;
    }

    switch (variant) {
      case 0:
        _paintRsi(canvas, size, candles);
      case 1:
        _paintStochastic(canvas, size, candles);
      case 2:
        _paintMacd(canvas, size, candles);
      case 3:
        _paintVolume(canvas, size, candles);
    }
  }

  List<MarketCandle> _visibleCandles() {
    if (marketCandles.length < 2) return const <MarketCandle>[];
    final historyCount = marketCandles.length;
    final maximumVisible = math.min(58, historyCount);
    final minimumVisible = math.min(16, maximumVisible);
    final visibleCount =
        (34 / zoom).round().clamp(minimumVisible, maximumVisible).toInt();
    final maxShift = historyCount - visibleCount;
    final shift = (pan * maxShift).round().clamp(0, maxShift).toInt();
    final end = historyCount - shift;
    return marketCandles.sublist(end - visibleCount, end);
  }

  void _paintRsi(Canvas canvas, Size size, List<MarketCandle> candles) {
    final rsi = _rsi(candles.map((candle) => candle.close).toList(), 14);
    final signal = _simpleAverage(rsi, 5);
    _drawNormalizedLine(canvas, size, rsi, const Color(0xFFFFE85C));
    _drawNormalizedLine(canvas, size, signal, const Color(0xFF62E9C4));
    _drawGuides(canvas, size, .30, .70);
  }

  void _paintStochastic(Canvas canvas, Size size, List<MarketCandle> candles) {
    final k = <double>[];
    for (int i = 0; i < candles.length; i++) {
      final start = math.max(0, i - 13);
      var low = candles[start].low;
      var high = candles[start].high;
      for (int j = start + 1; j <= i; j++) {
        low = math.min(low, candles[j].low).toDouble();
        high = math.max(high, candles[j].high).toDouble();
      }
      final range = high - low;
      k.add(range <= 0 ? 50 : (candles[i].close - low) / range * 100);
    }
    final d = _simpleAverage(k, 3);
    _drawNormalizedLine(canvas, size, k, Colors.white);
    _drawNormalizedLine(canvas, size, d, const Color(0xFFFF3D4F));
    _drawGuides(canvas, size, .20, .80);
  }

  void _paintMacd(Canvas canvas, Size size, List<MarketCandle> candles) {
    final closes = candles.map((candle) => candle.close).toList();
    final fast = _ema(closes, 12);
    final slow = _ema(closes, 26);
    final macd = List<double>.generate(
      closes.length,
      (index) => fast[index] - slow[index],
    );
    final signal = _ema(macd, 9);
    final histogram = List<double>.generate(
      closes.length,
      (index) => macd[index] - signal[index],
    );
    var maximum = .0000001;
    for (int i = 0; i < macd.length; i++) {
      maximum = math.max(maximum, macd[i].abs()).toDouble();
      maximum = math.max(maximum, signal[i].abs()).toDouble();
      maximum = math.max(maximum, histogram[i].abs()).toDouble();
    }

    final middle = size.height * .52;
    final slot = size.width / histogram.length;
    for (int i = 0; i < histogram.length; i++) {
      final y = middle - histogram[i] / maximum * size.height * .38;
      canvas.drawRect(
        Rect.fromLTRB(
          i * slot + 1,
          math.min(middle, y).toDouble(),
          (i + 1) * slot - 1,
          math.max(middle, y).toDouble(),
        ),
        Paint()
          ..color = histogram[i] >= 0
              ? const Color(0xFF65D832)
              : const Color(0xFFFF2639),
      );
    }
    _drawCenteredLine(canvas, size, macd, maximum, const Color(0xFFFFFFFF));
    _drawCenteredLine(canvas, size, signal, maximum, const Color(0xFFFF3D4F));
  }

  void _paintVolume(Canvas canvas, Size size, List<MarketCandle> candles) {
    final volumes =
        candles.map((candle) => candle.volume ?? 0).toList(growable: false);
    var maximum = 0.0;
    for (final volume in volumes) {
      maximum = math.max(maximum, volume).toDouble();
    }
    final values = maximum > 0
        ? volumes
        : candles
            .map((candle) =>
                (candle.high - candle.low).abs() +
                (candle.close - candle.open).abs())
            .toList(growable: false);
    maximum = .0000001;
    for (final value in values) {
      maximum = math.max(maximum, value).toDouble();
    }
    final slot = size.width / candles.length;
    final average = <double>[];
    for (int i = 0; i < candles.length; i++) {
      final height = (values[i] / maximum * size.height * .88)
          .clamp(1.0, size.height - 2)
          .toDouble();
      canvas.drawRect(
        Rect.fromLTWH(i * slot + 1, size.height - height,
            math.max(1.0, slot - 2).toDouble(), height),
        Paint()
          ..color = candles[i].close >= candles[i].open
              ? const Color(0xFF8BE800)
              : const Color(0xFFFF2436),
      );
      average.add(values[i] / maximum * 100);
    }
    _drawNormalizedLine(canvas, size, _simpleAverage(average, 6), Colors.white);
  }

  List<double> _rsi(List<double> closes, int period) {
    final values = <double>[50];
    for (int i = 1; i < closes.length; i++) {
      final start = math.max(1, i - period + 1);
      double gains = 0;
      double losses = 0;
      for (int j = start; j <= i; j++) {
        final change = closes[j] - closes[j - 1];
        if (change >= 0) {
          gains += change;
        } else {
          losses -= change;
        }
      }
      final count = i - start + 1;
      final averageGain = gains / count;
      final averageLoss = losses / count;
      if (averageLoss == 0) {
        values.add(averageGain == 0 ? 50 : 100);
      } else {
        values.add(100 - 100 / (1 + averageGain / averageLoss));
      }
    }
    return values;
  }

  List<double> _simpleAverage(List<double> values, int period) {
    return List<double>.generate(values.length, (index) {
      final start = math.max(0, index - period + 1);
      double total = 0;
      for (int i = start; i <= index; i++) {
        total += values[i];
      }
      return total / (index - start + 1);
    });
  }

  List<double> _ema(List<double> values, int period) {
    if (values.isEmpty) return const <double>[];
    final alpha = 2 / (period + 1);
    final result = <double>[values.first];
    for (int i = 1; i < values.length; i++) {
      result.add(values[i] * alpha + result.last * (1 - alpha));
    }
    return result;
  }

  void _drawNormalizedLine(
      Canvas canvas, Size size, List<double> values, Color color) {
    if (values.length < 2) return;
    final path = Path();
    for (int i = 0; i < values.length; i++) {
      final x = i * size.width / (values.length - 1);
      final y =
          size.height * (1 - (values[i] / 100).clamp(0.0, 1.0).toDouble());
      if (i == 0) {
        path.moveTo(x, y);
      } else {
        path.lineTo(x, y);
      }
    }
    canvas.drawPath(
      path,
      Paint()
        ..color = color
        ..strokeWidth = 1.7
        ..style = PaintingStyle.stroke,
    );
  }

  void _drawCenteredLine(Canvas canvas, Size size, List<double> values,
      double maximum, Color color) {
    if (values.length < 2) return;
    final path = Path();
    for (int i = 0; i < values.length; i++) {
      final x = i * size.width / (values.length - 1);
      final y = size.height * .52 - values[i] / maximum * size.height * .38;
      if (i == 0) {
        path.moveTo(x, y);
      } else {
        path.lineTo(x, y);
      }
    }
    canvas.drawPath(
      path,
      Paint()
        ..color = color
        ..strokeWidth = 1.7
        ..style = PaintingStyle.stroke,
    );
  }

  void _drawGuides(Canvas canvas, Size size, double upper, double lower) {
    final guide = Paint()
      ..color = const Color(0xFF64E7A7)
      ..strokeWidth = .8;
    canvas.drawLine(Offset(0, size.height * upper),
        Offset(size.width, size.height * upper), guide);
    canvas.drawLine(Offset(0, size.height * lower),
        Offset(size.width, size.height * lower), guide);
  }

  void _paintSynthetic(Canvas canvas, Size size) {
    if (variant == 3) {
      final rng = math.Random(77);
      for (int i = 0; i < 36; i++) {
        final slot = size.width / 36;
        final height = (size.height * (.18 + rng.nextDouble() * .68))
            .clamp(4.0, size.height - 5)
            .toDouble();
        final rising = math.sin(i * .78 + tick * .04) >= 0;
        canvas.drawRect(
          Rect.fromLTWH(i * slot + 1, size.height - height,
              math.max(2.0, slot - 3), height),
          Paint()
            ..color =
                rising ? const Color(0xFF8BE800) : const Color(0xFFFF2436),
        );
      }
      return;
    }

    if (variant == 2) {
      final middle = size.height * .52;
      for (int i = 0; i < 32; i++) {
        final x = i * size.width / 32;
        final value = math.sin(i * .29 + tick * .03) * size.height * .27;
        canvas.drawRect(
          Rect.fromLTRB(x + 1, middle, x + size.width / 38, middle + value),
          Paint()
            ..color =
                value < 0 ? const Color(0xFF65D832) : const Color(0xFFFF2639),
        );
      }
    }

    final colors = variant == 0
        ? const [Color(0xFFFFE85C), Color(0xFF62E9C4)]
        : const [Color(0xFFFFFFFF), Color(0xFFFF3D4F)];
    for (int line = 0; line < 2; line++) {
      final path = Path();
      for (int i = 0; i < 34; i++) {
        final x = i * size.width / 33;
        final phase = i * (.29 + variant * .035) + line * .72;
        final y = size.height * .5 +
            math.sin(phase + tick * .025) *
                size.height *
                (line == 0 ? .23 : .18);
        if (i == 0) {
          path.moveTo(x, y);
        } else {
          path.lineTo(x, y);
        }
      }
      canvas.drawPath(
        path,
        Paint()
          ..color = colors[line]
          ..strokeWidth = 1.7
          ..style = PaintingStyle.stroke,
      );
    }
    if (variant < 2) {
      _drawGuides(
          canvas, size, variant == 0 ? .30 : .22, variant == 0 ? .70 : .78);
    }
  }

  @override
  bool shouldRepaint(covariant IndicatorPainter oldDelegate) {
    return oldDelegate.variant != variant ||
        oldDelegate.tick != tick ||
        oldDelegate.marketCandles != marketCandles ||
        oldDelegate.zoom != zoom ||
        oldDelegate.pan != pan;
  }
}
