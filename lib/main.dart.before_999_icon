  int _trades = 5;
  int _marketTick = 0;
  int _expirySeconds = 60;
  int _remainingSeconds = 60;
  int _selectedTool = 0;
  int _navIndex = 2;
  double _amount = 1;
  double _zoom = 1;
  double _chartPan = 0;
  double _gestureStartZoom = 1;
  double? _livePrice;
  bool _aiRunning = false;
  bool _loadingCandles = false;
  bool _focusMode = false;
  bool _showStrategies = true;
  bool _ema9 = true;
  bool _ema21 = true;
  bool _bollinger = true;
  bool _zigZag = true;
  bool _showRsi = true;
