  bool _showStochastic = true;
  bool _showMacd = true;
  MarketFeedStatus _feedStatus = MarketFeedStatus.connecting;
  String? _feedError;
  int _historyRequest = 0;

  AssetQuote get _asset => _assets.firstWhere((item) => item.symbol == _symbol);

  @override
  void initState() {
    super.initState();
    _amountController = TextEditingController(text: '1.00');
    _marketTimer = Timer.periodic(const Duration(seconds: 1), (_) {
      if (!mounted) return;
      setState(() {
        _marketTick++;
        _remainingSeconds =
            _remainingSeconds <= 1 ? _expirySeconds : _remainingSeconds - 1;
      });
    });
    _historyRefreshTimer = Timer.periodic(
      const Duration(minutes: 1),
      (_) => _loadCandleHistory(showLoading: false),
    );
    unawaited(_connectMarketData());
  }

  @override
  void dispose() {
    _marketTimer?.cancel();
    _historyRefreshTimer?.cancel();
    unawaited(_marketData.dispose());
    _amountController.dispose();
    super.dispose();
  }

  Future<void> _connectMarketData() async {
    if (!_marketData.isConfigured) {
      if (!mounted) return;
      setState(() {
        _feedStatus = MarketFeedStatus.missingKey;
        _feedError = 'Start with --dart-define=TWELVE_DATA_API_KEY=YOUR_KEY';
      });
      return;
    }

    final requestedSymbol = _symbol;
    await _loadCandleHistory();
    if (!mounted || requestedSymbol != _symbol) return;
    unawaited(
      _marketData.connectPrice(
        symbol: requestedSymbol,
        onPrice: (price) {
          if (requestedSymbol == _symbol) _handleLivePrice(price);
        },
        onStatus: (status) {
          if (!mounted || requestedSymbol != _symbol) return;
          setState(() => _feedStatus = status);
        },
        onError: (message) {
          if (!mounted || requestedSymbol != _symbol) return;
          setState(() => _feedError = message);
        },
      ),
    );
  }

  Future<void> _loadCandleHistory({bool showLoading = true}) async {
    if (!_marketData.isConfigured) return;
    final request = ++_historyRequest;
    final requestedSymbol = _symbol;
    final requestedTimeframe = _timeframe;
    if (mounted && showLoading) {
      setState(() {
        _loadingCandles = true;
        _feedError = null;
      });
    }
    try {
      final candles = await _marketData.fetchCandles(
        symbol: requestedSymbol,
        timeframe: requestedTimeframe,
      );
      if (!mounted ||
          request != _historyRequest ||
          requestedSymbol != _symbol ||
          requestedTimeframe != _timeframe) {
        return;
      }
      final price = candles.last.close;
      setState(() {
        _marketCandles = candles;
        _livePrice = price;
        _livePrices[requestedSymbol] = price;
        _loadingCandles = false;
        if (_feedStatus != MarketFeedStatus.live) {
          _feedStatus = MarketFeedStatus.historyOnly;
        }
      });
    } catch (error) {
      if (!mounted || request != _historyRequest) return;
      setState(() {
        _loadingCandles = false;
        _feedStatus = MarketFeedStatus.error;
        _feedError = error.toString();
      });
    }
  }

  void _handleLivePrice(double price) {
    if (!mounted || !price.isFinite || price <= 0) return;
    final now = DateTime.now().toUtc();
    final interval = _marketData.durationFor(_timeframe);
    final bucketMilliseconds = interval.inMilliseconds;
    final bucket = DateTime.fromMillisecondsSinceEpoch(
      (now.millisecondsSinceEpoch ~/ bucketMilliseconds) * bucketMilliseconds,
      isUtc: true,
    );

    setState(() {
      _livePrice = price;
      _livePrices[_symbol] = price;
      _feedStatus = MarketFeedStatus.live;
      _feedError = null;
      if (_marketCandles.isEmpty) return;
      final candles = List<MarketCandle>.from(_marketCandles);
      final last = candles.last;
      if (last.time.isBefore(bucket)) {
        candles.add(MarketCandle(
          time: bucket,
          open: last.close,
          high: math.max(last.close, price).toDouble(),
          low: math.min(last.close, price).toDouble(),
          close: price,
        ));
      } else {
        candles[candles.length - 1] = last.copyWith(
          high: math.max(last.high, price).toDouble(),
          low: math.min(last.low, price).toDouble(),
          close: price,
        );
      }
      _marketCandles = candles.length > 240
          ? candles.sublist(candles.length - 240)
          : candles;
    });
  }

  void _selectSymbol(String symbol) {
    if (symbol == _symbol) return;
    unawaited(_marketData.disconnectPrice());
    setState(() {
      _symbol = symbol;
      _marketCandles = <MarketCandle>[];
      _livePrice = _livePrices[symbol];
      _zoom = 1;
      _chartPan = 0;
    });
    unawaited(_connectMarketData());
  }

  void _selectTimeframe(String timeframe) {
    if (timeframe == _timeframe) return;
    setState(() {
      _timeframe = timeframe;
      _marketCandles = <MarketCandle>[];
      _zoom = 1;
      _chartPan = 0;
    });
    unawaited(_loadCandleHistory());
  }

  void _setZoom(double value) {
    setState(() {
      _zoom = value.clamp(.60, 2.50).toDouble();
    });
  }

  void _resetZoom() {
    setState(() {
      _zoom = 1;
      _chartPan = 0;
    });
  }

  void _handleChartPointerSignal(PointerSignalEvent event) {
    if (_drawingMode || event is! PointerScrollEvent) return;
    final factor = event.scrollDelta.dy > 0 ? .90 : 1.10;
    _setZoom(_zoom * factor);
  }

  void _startChartGesture(ScaleStartDetails details) {
    _gestureStartZoom = _zoom;
  }

  void _updateChartGesture(ScaleUpdateDetails details) {
    if (_drawingMode) return;
    final nextZoom =
        (_gestureStartZoom * details.scale).clamp(.60, 2.50).toDouble();
    final isDrag = (details.scale - 1).abs() < .002;
    setState(() {
      _zoom = nextZoom;
      if (isDrag && details.focalPointDelta.dx.abs() > .1) {
        _chartPan = (_chartPan + details.focalPointDelta.dx / 520)
            .clamp(0.0, 1.0)
            .toDouble();
      }
    });
  }

  bool get _drawingMode =>
      _selectedTool == 2 || _selectedTool == 3 || _selectedTool == 4;

  Offset _normalizePoint(Offset point, Size size) {
    return Offset(
      (point.dx / size.width).clamp(0.0, 1.0).toDouble(),
      (point.dy / size.height).clamp(0.0, 1.0).toDouble(),
    );
  }

  void _startChartDrawing(DragStartDetails details, Size size) {
    if (_selectedTool != 2 && _selectedTool != 4) return;
    setState(() {
      _activeDrawing = <Offset>[_normalizePoint(details.localPosition, size)];
    });
  }

  void _updateChartDrawing(DragUpdateDetails details, Size size) {
    if (_activeDrawing.isEmpty) return;
    final point = _normalizePoint(details.localPosition, size);
    setState(() {
      if (_selectedTool == 4) {
        _activeDrawing = <Offset>[_activeDrawing.first, point];
      } else {
        _activeDrawing = <Offset>[..._activeDrawing, point];
      }
    });
  }

  void _finishChartDrawing() {
    if (_activeDrawing.length < 2) {
      setState(() => _activeDrawing = <Offset>[]);
      return;
    }
    setState(() {
      _drawings.add(
        ChartDrawing(
          tool: _selectedTool,
          points: List<Offset>.unmodifiable(_activeDrawing),
        ),
      );
      _activeDrawing = <Offset>[];
    });
  }

  void _addHorizontalDrawing(TapDownDetails details, Size size) {
    if (_selectedTool != 3) return;
    final y = _normalizePoint(details.localPosition, size).dy;
    setState(() {
      _drawings.add(
        ChartDrawing(
          tool: 3,
          points: <Offset>[Offset(0, y), Offset(1, y)],
        ),
      );
    });
  }

  void _undoDrawing() {
    setState(() {
      if (_drawings.isNotEmpty) _drawings.removeLast();
      _activeDrawing = <Offset>[];
      _selectedTool = 0;
    });
    _notice(_drawings.isEmpty
        ? 'Chart drawing cleared.'
        : 'Last chart drawing removed.');
  }

