  Widget _toolButton(IconData icon, int index) {
    final selected = index == _selectedTool;
    return Tooltip(
      message: const [
        'Cursor',
        'Chart type',
        'Draw',
        'Horizontal line',
        'Trend line',
        'Undo',
        'Chart settings',
      ][index],
      child: InkWell(
        onTap: () {
          if (index == 1) {
            setState(() {
              _selectedTool = 0;
              _chartStyle = _chartStyle == 'Candles' ? 'Line' : 'Candles';
            });
          } else if (index == 5) {
            _undoDrawing();
          } else if (index == 6) {
            setState(() => _selectedTool = 0);
            _openChartSettings();
          } else {
            setState(() => _selectedTool = index);
            _notice('${const [
              'Cursor',
              'Chart type',
              'Drawing pencil',
              'Horizontal line',
              'Trend line',
              'Undo',
              'Chart settings'
            ][index]} selected.');
          }
        },
        child: AnimatedContainer(
          duration: const Duration(milliseconds: 150),
          width: 48,
          height: 48,
          margin: const EdgeInsets.all(3),
          decoration: BoxDecoration(
            color: selected ? const Color(0xFF273766) : Colors.transparent,
            borderRadius: BorderRadius.circular(9),
            border:
                selected ? Border.all(color: const Color(0xFF7772FF)) : null,
          ),
          child: Icon(icon,
              size: 20,
              color: selected ? const Color(0xFFB4C3FF) : Colors.white60),
        ),
      ),
    );
  }

