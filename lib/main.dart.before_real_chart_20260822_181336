class MasterChartPainter extends CustomPainter {
  const MasterChartPainter();

  @override
  void paint(Canvas canvas, Size size) {
    final grid = Paint()
      ..color = const Color(0xFF132536)
      ..strokeWidth = .7;

    for (var i = 1; i < 12; i++) {
      final x = size.width * i / 12;
      canvas.drawLine(
        Offset(x, 0),
        Offset(x, size.height),
        grid,
      );
    }

    for (var i = 1; i < 8; i++) {
      final y = size.height * i / 8;
      canvas.drawLine(
        Offset(0, y),
        Offset(size.width, y),
        grid,
      );
    }

    final rand = math.Random(999);

    double price = size.height * .52;

    final candleSpacing = math.max(7.0, size.width / 75);

    final count = math.max(28, (size.width / candleSpacing).floor());

    final ema9 = <Offset>[];
    final ema21 = <Offset>[];
    final ema50 = <Offset>[];

    for (var i = 0; i < count; i++) {
      final x = i * candleSpacing + 10;

      final move = (rand.nextDouble() - .48) * 22;

      final open = price;
      final close = price - move;

      final high = math.min(open, close) - rand.nextDouble() * 10;

      final low = math.max(open, close) + rand.nextDouble() * 10;

      final bullish = close < open;

      final paint = Paint()
        ..color = bullish ? const Color(0xFF12D989) : const Color(0xFFFF4D57)
        ..strokeWidth = 1.2;

      canvas.drawLine(
        Offset(x, high),
        Offset(x, low),
        paint,
      );

      canvas.drawRect(
        Rect.fromLTWH(
          x - 3,
          math.min(open, close),
          6,
          math.max(2, (close - open).abs()),
        ),
        paint,
      );

      price = close;

      ema9.add(
        Offset(
          x,
          close + math.sin(i / 3) * 7,
        ),
      );

      ema21.add(
        Offset(
          x,
          close + 10 + math.sin(i / 5) * 6,
        ),
      );

      ema50.add(
        Offset(
          x,
          close + 22 + math.sin(i / 7) * 5,
        ),
      );
    }

    void drawPath(
      List<Offset> points,
      Color color,
    ) {
      if (points.length < 2) return;

      final path = Path()
        ..moveTo(
          points.first.dx,
          points.first.dy,
        );

      for (final point in points.skip(1)) {
        path.lineTo(point.dx, point.dy);
      }

      canvas.drawPath(
        path,
        Paint()
          ..color = color
          ..strokeWidth = 1.3
          ..style = PaintingStyle.stroke,
      );
    }

    drawPath(
      ema9,
      const Color(0xFFA35BFF),
    );

    drawPath(
      ema21,
      const Color(0xFFFFA62B),
    );

    drawPath(
      ema50,
      const Color(0xFF258CFF),
    );

    final priceLine = Paint()
      ..color = const Color(0xFF15DAB2)
      ..strokeWidth = .8;

    canvas.drawLine(
      Offset(0, price),
      Offset(size.width, price),
      priceLine,
    );

    final rsiY = size.height * .74;

    canvas.drawLine(
      Offset(0, rsiY),
      Offset(size.width, rsiY),
      Paint()
        ..color = const Color(0xFF432867)
        ..strokeWidth = 1,
    );

    final histogramBase = size.height * .93;

    for (var i = 0; i < 32; i++) {
      final x = size.width * i / 32;

      final magnitude = 5 + rand.nextDouble() * 26;

      final positive = rand.nextBool();

      final p = Paint()
        ..color = positive ? const Color(0xFF12D989) : const Color(0xFFFF4D57);

      canvas.drawRect(
        Rect.fromLTWH(
          x + 2,
          histogramBase - (positive ? magnitude : 0),
          math.max(2, size.width / 40),
          magnitude,
        ),
        p,
      );
    }
  }

  @override
  bool shouldRepaint(
    covariant MasterChartPainter oldDelegate,
  ) {
    return false;
  }
}

