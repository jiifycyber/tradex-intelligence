  Future<void> _connectMarketData() async {
    final requestedSymbol = selectedSymbol;
    final requestedTimeframe = timeframe;

    if (!mounted) return;

    setState(() {
      _loadingCandles = true;
      _feedStatus = MarketFeedStatus.connecting;
      _feedError = null;
    });

    try {
      final candles = await _marketData.fetchCandles(
        symbol: requestedSymbol,
        timeframe: requestedTimeframe,
        outputSize: 120,
      );

      if (!mounted ||
          requestedSymbol != selectedSymbol ||
          requestedTimeframe != timeframe) {
        return;
      }

      final latestPrice = candles.last.close;

      setState(() {
        _marketCandles = candles;
        _livePrice = latestPrice;
        _knownPrices[requestedSymbol] = latestPrice;
        _loadingCandles = false;
        _feedStatus = MarketFeedStatus.historyOnly;
      });
    } catch (error) {
      if (!mounted ||
          requestedSymbol != selectedSymbol ||
          requestedTimeframe != timeframe) {
        return;
      }

      setState(() {
        _loadingCandles = false;
        _feedStatus = MarketFeedStatus.error;
        _feedError = error.toString();
      });

      return;
    }

    if (!live) return;

    await _marketData.connectPrice(
      symbol: requestedSymbol,
      onPrice: (price) {
        if (!mounted || requestedSymbol != selectedSymbol || !live) {
          return;
        }

        _handleLivePrice(price);
      },
      onStatus: (status) {
        if (!mounted || requestedSymbol != selectedSymbol) {
          return;
        }

        setState(() {
          _feedStatus = status;
        });
      },
      onError: (message) {
        if (!mounted || requestedSymbol != selectedSymbol) {
          return;
        }

        setState(() {
          _feedError = message;
        });
      },
    );
  }

  void _handleLivePrice(double price) {
    if (!mounted || !price.isFinite || price <= 0) return;

    final now = DateTime.now().toUtc();
    final duration = _marketData.durationFor(timeframe);
    final bucketMs = duration.inMilliseconds;

    final bucket = DateTime.fromMillisecondsSinceEpoch(
      (now.millisecondsSinceEpoch ~/ bucketMs) * bucketMs,
      isUtc: true,
    );

    setState(() {
      _livePrice = price;
      _knownPrices[selectedSymbol] = price;

      if (_marketCandles.isEmpty) return;

      final candles = List<MarketCandle>.from(_marketCandles);
      final last = candles.last;

      if (last.time.isBefore(bucket)) {
        candles.add(
          MarketCandle(
            time: bucket,
            open: last.close,
            high: price,
            low: price,
            close: price,
            volume: 0,
          ),
        );
      } else {
        candles[candles.length - 1] = last.copyWith(
          high: math.max(last.high, price).toDouble(),
          low: math.min(last.low, price).toDouble(),
          close: price,
        );
      }

      _marketCandles = candles.length > 240
          ? candles.sublist(candles.length - 240)
          : candles;
    });
  }

